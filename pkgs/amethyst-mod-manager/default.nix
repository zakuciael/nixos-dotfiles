buildFHSEnv {
  name = "amethyst-mod-manager";

  multiArch = true;

  targetPkgs = _: [
    amethyst-mod-manager-unwrapped
    (_7zz.override { enableUnfree = true; })
    bash
    cabextract
    glib
    python3
    winetricks
    xdg-utils
  ];

  multiPkgs = _: [
    libGL
    libGLU
    libdrm
    libva
    mesa.llvmPackages.llvm.lib
