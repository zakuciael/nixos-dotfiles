+/**
+ * Rewrite composer `$name` mentions to Cursor's `/name` form and pin each
+ * resolved SKILL.md path onto the prompt.
+ *
+ * The Cursor Agent SDK loads ambient skills only through settingSources, and
+ * personal/slash-only skills (Home Manager symlink farms, disable-model-
+ * invocation) often never appear in the session catalog. Without the path,
+ * `/name` is opaque text and the model hunts under ~/.cursor/skills*.
+ */
 export function rewriteCursorSkillMentions(
   prompt: string,
-  skillNames: ReadonlySet<string>,
+  skillsByName: ReadonlyMap<string, string>,
 ): string {
-  return prompt.replace(SKILL_MENTION_PATTERN, (match, prefix: string, name: string) =>
-    skillNames.has(name) ? `${prefix}/${name}` : match,
+  const mentioned = new Map<string, string>();
+  const rewritten = prompt.replace(
+    SKILL_MENTION_PATTERN,
+    (match, prefix: string, name: string) => {
+      const skillPath = skillsByName.get(name);
+      if (skillPath === undefined) return match;
+      mentioned.set(name, skillPath);
+      return `${prefix}/${name}`;
+    },
+  );
+  if (mentioned.size === 0) return rewritten;
+
+  const lines = [...mentioned.entries()]
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(
+      ([name, skillPath]) =>
+        `- \`/${name}\`: Read \`${skillPath}\` immediately and follow it. Do not search the filesystem for this skill.`,
+    );
+  return (
+    `${rewritten}\n\n` +
+    "<t3_cursor_skill_invocation>\n" +
+    "The user invoked Cursor Agent Skill(s) by name. Use these resolved paths instead of looking the skills up:\n" +
+    `${lines.join("\n")}\n` +
+    "</t3_cursor_skill_invocation>"
   );
 }
