{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "enabledManagers": ["nix"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "labels": ["type: deps"],
  "semanticCommits": "enabled",
  "automerge": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "hostRules": [
    {
      "description": "Read access to private nostale-dev-env flake input. Add the PAT as secret NOSTALE_DEV_ENV_TOKEN in developer.mend.io (Contents: Read).",
      "matchHost": "https://api.github.com/repos/zakuciael/nostale-dev-env",
      "hostType": "github",
      "token": "{{ secrets.NOSTALE_DEV_ENV_TOKEN }}"
    },
    {
      "description": "git ls-remote for private nostale-dev-env over HTTPS",
      "matchHost": "https://github.com/zakuciael/nostale-dev-env",
      "token": "{{ secrets.NOSTALE_DEV_ENV_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "FlakeHub URLs are not git remotes — Renovate cannot git-refs them (usually transitive Determinate inputs colliding on lock-node names)",
      "matchManagers": ["nix"],
      "matchPackageNames": ["/^https:\\/\\/flakehub\\.com\\//"],
      "enabled": false
    }
  ]
}
